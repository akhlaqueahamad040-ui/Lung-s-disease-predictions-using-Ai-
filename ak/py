# ── Helper Functions ──
def get_db():
    import sqlite3
    db = sqlite3.connect(os.path.join(BASE_DIR, "xray.db"))
    db.row_factory = sqlite3.Row
    return db


def allowed_file(filename):
    return "." in filename and filename.rsplit(".", 1)[1].lower() in ALLOWED_EXTENSIONS


def analyze_xray_with_ai(image_path: str) -> dict:
    import anthropic

    api_key = os.environ.get("ANTHROPIC_API_KEY", "")
    if not api_key:
        return _mock_xray_analysis()  # Demo mode

    with open(image_path, "rb") as f:
        image_bytes = f.read()

    ext = image_path.rsplit(".", 1)[-1].lower()
    media_map = {"jpg": "image/jpeg", "jpeg": "image/jpeg",
                 "png": "image/png", "webp": "image/webp"}
    media_type = media_map.get(ext, "image/jpeg")
    b64_image = base64.standard_b64encode(image_bytes).decode("utf-8")

    client = anthropic.Anthropic(api_key=api_key)

    system_prompt = """You are an expert radiologist AI assistant.
Analyze the chest X-ray and respond ONLY with valid JSON:
{
  "finding": "Normal | Abnormal | Suspicious",
  "confidence": <float 0-100>,
  "primary_diagnosis": "<brief diagnosis>",
  "observations": ["<obs1>", "<obs2>", "<obs3>"],
  "lung_fields": "<description>",
  "cardiac_silhouette": "<description>",
  "pleural_spaces": "<description>",
  "bones_and_soft_tissue": "<description>",
  "recommendation": "<clinical recommendation>",
  "urgency": "Routine | Urgent | Emergency"
}"""

    response = client.messages.create(
        model="claude-opus-4-5",
        max_tokens=1024,
        system=system_prompt,
        messages=[{
            "role": "user",
            "content": [
                {
                    "type": "image",
                    "source": {
                        "type": "base64",
                        "media_type": media_type,
                        "data": b64_image,
                    },
                },
                {
                    "type": "text",
                    "text": "Analyze this chest X-ray and return JSON report."
                }
            ],
        }],
    )

    raw = response.content[0].text.strip()
    if raw.startswith(""):
        raw = raw.split("")[1]
        if raw.startswith("json"):
            raw = raw[4:]
    return json.loads(raw)


